{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "typeRoots": ["./ui/node_modules/@types"],
    "types": ["node"]
  },
  "include": [
    "index.ts",
    "laws/**/*.ts",
    "rules/**/*.ts",
    "protocols/**/*.ts",
    "skills/**/*.ts",
    "hooks/**/*.ts",
    "registry/**/*.ts",
    "engines/orchestrator/*.ts",
    "engines/scripts/sync-plugin.ts",
    "core/siddhanta/*.ts"
  ]
}
